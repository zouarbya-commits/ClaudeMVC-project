@model ClaudeMVC.Models.Parcelle
@{
    ViewData["Title"] = Model.Nom;
    var stripClass = Model.Type == ClaudeMVC.Models.TypeParcelle.EcoTourisme ? "strip-eco" :
                     Model.Type == ClaudeMVC.Models.TypeParcelle.Arboricole ? "strip-arbo" : "strip-vide";
}

<div class="mb-3">
    <a asp-controller="Parcelles" asp-action="Index" class="text-decoration-none text-muted small">
        <i class="bi bi-arrow-left me-1"></i>Parcelles
    </a>
</div>

<div class="row g-3">
    <!-- Fiche principale -->
    <div class="col-lg-4">
        <div class="parcelle-card mb-3">
            <div class="card-header-strip @stripClass" style="height:6px"></div>
            <div class="p-4">
                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <span class="badge bg-@Model.CouleurBadge bg-opacity-10 text-@Model.CouleurBadge border border-@Model.CouleurBadge border-opacity-25 mb-2">@Model.Type</span>
                        <h5 class="fw-bold mb-1">@Model.Nom</h5>
                        <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@Model.Localisation</div>
                    </div>
                </div>
                <p class="text-muted small">@Model.Description</p>
                <hr>
                <div class="row g-2 text-center">
                    <div class="col-6">
                        <div class="fw-bold fs-5">@Model.SuperficieHa ha</div>
                        <div class="text-muted" style="font-size:0.7rem">Superficie</div>
                    </div>
                    @if (Model.AltitudeMetre != null)
                    {
                        <div class="col-6">
                            <div class="fw-bold fs-5">@Model.AltitudeMetre</div>
                            <div class="text-muted" style="font-size:0.7rem">Altitude</div>
                        </div>
                    }
                    <div class="col-6">
                        <div class="fw-bold fs-5 text-success">@((Model.RevenusAnnuelsEstimes ?? 0).ToString("N0"))</div>
                        <div class="text-muted" style="font-size:0.7rem">Revenus estimés (MAD)</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold fs-5 text-@(Model.MargeNette >= 0 ? "success" : "danger")">@Model.MargeNette.ToString("N0")</div>
                        <div class="text-muted" style="font-size:0.7rem">Marge nette (MAD)</div>
                    </div>
                </div>
                <hr>
                <div class="d-grid gap-2">
                    @if (Model.Type == ClaudeMVC.Models.TypeParcelle.Arboricole)
                    {
                        <a asp-controller="Rentabilite" asp-action="Parcelle" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-bar-chart-line me-1"></i>Analyse rentabilité
                        </a>
                    }
                    @if (Model.Type == ClaudeMVC.Models.TypeParcelle.EcoTourisme)
                    {
                        <a asp-controller="EcoTourisme" asp-action="BusinessPlan" asp-route-parcelleId="@Model.Id" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-compass me-1"></i>Business Plan
                        </a>
                    }
                    @if (Model.Type == ClaudeMVC.Models.TypeParcelle.TerrainVide)
                    {
                        <a asp-controller="Evaluation" asp-action="Index" class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-clipboard-data me-1"></i>Évaluation terrain
                        </a>
                    }
                    <a asp-controller="Interventions" asp-action="Index" asp-route-parcelleId="@Model.Id" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-calendar-check me-1"></i>Interventions
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (Model.Cultures.Any())
        {
            <div class="bg-white rounded-3 border p-3 mb-3">
                <h6 class="fw-semibold mb-3">Cultures</h6>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Espèce</th>
                                <th>Superficie</th>
                                <th>Arbres</th>
                                <th>Rendement kg/ha</th>
                                <th>Prix vente/kg</th>
                                <th>Revenu brut</th>
                                <th>Marge nette</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Cultures)
                            {
                                <tr>
                                    <td>@c.Icone @c.Espece</td>
                                    <td>@c.SuperficieHa ha</td>
                                    <td>@c.NombreArbres</td>
                                    <td>@c.RendementKgHa.ToString("N0")</td>
                                    <td>@c.PrixVenteKg MAD</td>
                                    <td class="text-success fw-medium">@c.RevenuBrutEstime.ToString("N0") MAD</td>
                                    <td class="fw-medium text-@(c.MargeNette >= 0 ? "success" : "danger")">@c.MargeNette.ToString("N0") MAD</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="5">Total</td>
                                <td class="text-success">@Model.Cultures.Sum(c => c.RevenuBrutEstime).ToString("N0") MAD</td>
                                <td>@Model.Cultures.Sum(c => c.MargeNette).ToString("N0") MAD</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

        <!-- Interventions récentes -->
        <div class="bg-white rounded-3 border p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0">Interventions planifiées</h6>
                <a asp-controller="Interventions" asp-action="Create" class="btn btn-sm btn-success">
                    <i class="bi bi-plus me-1"></i>Ajouter
                </a>
            </div>
            @if (!Model.Interventions.Any())
            {
                <p class="text-muted small text-center py-3">Aucune intervention enregistrée</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr><th>Type</th><th>Description</th><th>Date prévue</th><th>Coût</th><th>Statut</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Interventions.OrderBy(x => x.DatePrevue))
                            {
                                <tr>
                                    <td><span class="badge bg-@i.CouleurType bg-opacity-10 text-@i.CouleurType border border-@i.CouleurType border-opacity-25"><i class="bi @i.IconeType me-1"></i>@i.Type</span></td>
                                    <td class="small">@i.Description</td>
                                    <td class="small">@i.DatePrevue.ToString("d MMM yyyy")</td>
                                    <td class="small">@i.CoutTotal.ToString("N0") MAD</td>
                                    <td>
                                        @if (i.EstRealisee)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Réalisée</span>
                                        }
                                        else if (i.DatePrevue < DateTime.Today)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">En retard</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">Planifiée</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
