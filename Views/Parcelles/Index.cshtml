@model List<ClaudeMVC.Models.Parcelle>
@{
    ViewData["Title"] = "Mes Parcelles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">@Model.Count parcelles · @Model.Sum(p => p.SuperficieHa).ToString("F1") ha au total</p>
    </div>
</div>

<div class="row g-3">
@foreach (var p in Model)
{
    var stripClass = p.Type == ClaudeMVC.Models.TypeParcelle.EcoTourisme ? "strip-eco" :
                     p.Type == ClaudeMVC.Models.TypeParcelle.Arboricole ? "strip-arbo" : "strip-vide";
    var marge = p.MargeNette;
    var margeColor = marge >= 0 ? "success" : "danger";
    <div class="col-md-6 col-xl-4">
        <div class="parcelle-card h-100">
            <div class="card-header-strip @stripClass"></div>
            <div class="p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h6 class="fw-bold mb-1">@p.Nom</h6>
                        <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@p.Localisation</div>
                        @if (p.AltitudeMetre != null)
                        {
                            <div class="text-muted small"><i class="bi bi-triangle me-1"></i>@p.AltitudeMetre</div>
                        }
                    </div>
                    <div class="text-end">
                        <span class="badge bg-@p.CouleurBadge bg-opacity-10 text-@p.CouleurBadge border border-@p.CouleurBadge border-opacity-25 d-block mb-1">@p.Type</span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">@p.Statut</span>
                    </div>
                </div>

                <p class="text-muted small mb-3">@p.Description</p>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="rounded-2 p-2 text-center" style="background:#f9fafb">
                            <div class="fw-bold">@p.SuperficieHa ha</div>
                            <div class="text-muted" style="font-size:0.7rem">Superficie</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="rounded-2 p-2 text-center" style="background:#f9fafb">
                            <div class="fw-bold text-@margeColor">@marge.ToString("N0") MAD</div>
                            <div class="text-muted" style="font-size:0.7rem">Marge nette</div>
                        </div>
                    </div>
                </div>

                @if (p.Cultures.Any())
                {
                    <div class="mb-3">
                        <div class="text-muted small fw-semibold mb-1">Cultures</div>
                        @foreach (var c in p.Cultures)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 me-1 mb-1">
                                @c.Icone @c.Espece (@c.SuperficieHa ha)
                            </span>
                        }
                    </div>
                }

                <div class="d-flex gap-2">
                    <a asp-controller="Parcelles" asp-action="Details" asp-route-id="@p.Id"
                       class="btn btn-sm btn-outline-success flex-grow-1">
                        <i class="bi bi-eye me-1"></i>Détails
                    </a>
                    <a asp-controller="Interventions" asp-action="Index" asp-route-parcelleId="@p.Id"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-calendar-check"></i>
                    </a>
                    @if (p.Type == ClaudeMVC.Models.TypeParcelle.Arboricole)
                    {
                        <a asp-controller="Rentabilite" asp-action="Parcelle" asp-route-id="@p.Id"
                           class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-bar-chart-line"></i>
                        </a>
                    }
                    @if (p.Type == ClaudeMVC.Models.TypeParcelle.EcoTourisme)
                    {
                        <a asp-controller="EcoTourisme" asp-action="BusinessPlan" asp-route-parcelleId="@p.Id"
                           class="btn btn-sm btn-outline-info">
                            <i class="bi bi-compass"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>
