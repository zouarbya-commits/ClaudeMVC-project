@{
    ViewData["Title"] = "Accueil";
}

<!-- Hero Section -->
<section class="bg-dark text-white py-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold mb-3">
                    Bienvenue sur <span class="text-primary">ClaudeMVC</span>
                </h1>
                <p class="lead mb-4">
                    Un projet <strong>ASP.NET Core MVC</strong> moderne basé sur
                    <strong>.NET 9</strong>, <strong>Bootstrap 5.3</strong> et les dernières
                    technologies web.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="#features" class="btn btn-primary btn-lg">
                        <i class="bi bi-rocket-takeoff me-2"></i>Découvrir
                    </a>
                    <a asp-action="Privacy" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-info-circle me-2"></i>En savoir plus
                    </a>
                </div>
            </div>
            <div class="col-lg-5 mt-4 mt-lg-0 text-center">
                <i class="bi bi-code-slash" style="font-size: 8rem; opacity: 0.2;"></i>
            </div>
        </div>
    </div>
</section>

<!-- Tech Badges -->
<section class="bg-primary bg-gradient py-3">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <span class="badge bg-dark fs-6 px-3 py-2">
                <i class="bi bi-microsoft me-1"></i>.NET 9
            </span>
            <span class="badge bg-dark fs-6 px-3 py-2">
                <i class="bi bi-bootstrap me-1"></i>Bootstrap 5.3
            </span>
            <span class="badge bg-dark fs-6 px-3 py-2">
                <i class="bi bi-filetype-css me-1"></i>CSS 3
            </span>
            <span class="badge bg-dark fs-6 px-3 py-2">
                <i class="bi bi-filetype-js me-1"></i>JavaScript ES2024
            </span>
            <span class="badge bg-dark fs-6 px-3 py-2">
                <i class="bi bi-layers me-1"></i>MVC Pattern
            </span>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-2">Fonctionnalités</h2>
        <p class="text-center text-muted mb-5">Ce projet intègre les meilleures pratiques modernes</p>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:64px;height:64px;">
                            <i class="bi bi-lightning-charge text-primary fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">.NET 9</h5>
                        <p class="card-text text-muted">
                            Dernière version LTS avec performances améliorées,
                            minimal APIs et support natif AOT.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:64px;height:64px;">
                            <i class="bi bi-bootstrap text-success fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Bootstrap 5.3</h5>
                        <p class="card-text text-muted">
                            Framework CSS responsive avec support du mode sombre,
                            composants modernes et utilitaires flexbox/grid.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:64px;height:64px;">
                            <i class="bi bi-layers text-warning fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Architecture MVC</h5>
                        <p class="card-text text-muted">
                            Pattern Model-View-Controller pour une séparation claire
                            des responsabilités et une maintenabilité optimale.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:64px;height:64px;">
                            <i class="bi bi-tags text-info fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Tag Helpers</h5>
                        <p class="card-text text-muted">
                            Helpers Razor pour générer du HTML propre avec la liaison
                            de données côté serveur intégrée.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:64px;height:64px;">
                            <i class="bi bi-shield-check text-danger fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Sécurité intégrée</h5>
                        <p class="card-text text-muted">
                            Protection CSRF, HTTPS par défaut et injection de dépendances
                            native pour une architecture sécurisée.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:64px;height:64px;">
                            <i class="bi bi-phone text-secondary fs-3"></i>
                        </div>
                        <h5 class="card-title fw-bold">Responsive Design</h5>
                        <p class="card-text text-muted">
                            Interface adaptative pour tous les écrans grâce au
                            système de grille Bootstrap et aux media queries CSS.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="bg-primary text-white py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Prêt à démarrer ?</h2>
        <p class="lead mb-4">Modifiez ce projet selon vos besoins et commencez à développer.</p>
        <a asp-action="Privacy" class="btn btn-light btn-lg">
            <i class="bi bi-arrow-right-circle me-2"></i>En savoir plus
        </a>
    </div>
</section>
