@model ClaudeMVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "Tableau de bord";
    var margeColor = Model.MargeNetteTotale > 0 ? "success" : "danger";
}

<!-- KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small mb-1">Superficie totale</div>
                    <div class="fs-4 fw-bold">@Model.TotalSuperficieHa.ToString("F1") ha</div>
                    <div class="text-muted small">@Model.Parcelles.Count parcelles</div>
                </div>
                <div class="stat-icon" style="background:#d1fae5;font-size:1.4rem">🗺️</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small mb-1">Revenus estimés</div>
                    <div class="fs-4 fw-bold text-success">@Model.TotalRevenusEstimes.ToString("N0") MAD</div>
                    <div class="text-muted small">annuel</div>
                </div>
                <div class="stat-icon" style="background:#d1fae5;font-size:1.4rem">💰</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small mb-1">Marge nette</div>
                    <div class="fs-4 fw-bold text-@margeColor">@Model.MargeNetteTotale.ToString("N0") MAD</div>
                    <div class="text-muted small">après charges</div>
                </div>
                <div class="stat-icon" style="background:#fef3c7;font-size:1.4rem">📊</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small mb-1">Interventions</div>
                    <div class="fs-4 fw-bold">@Model.NombreInterventionsMois <span class="fs-6 text-muted">ce mois</span></div>
                    @if (Model.NombreInterventionsEnRetard > 0)
                    {
                        <div class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>@Model.NombreInterventionsEnRetard en retard</div>
                    }
                    else
                    {
                        <div class="text-success small"><i class="bi bi-check-circle me-1"></i>Aucun retard</div>
                    }
                </div>
                <div class="stat-icon" style="background:#fee2e2;font-size:1.4rem">📅</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Parcelles cards -->
    <div class="col-lg-8">
        <div class="bg-white rounded-3 border p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 fw-semibold">Mes Parcelles</h6>
                <a asp-controller="Parcelles" asp-action="Index" class="btn btn-sm btn-outline-success">Voir tout</a>
            </div>
            <div class="row g-2">
                @foreach (var p in Model.Parcelles)
                {
                    var stripClass = p.Type == ClaudeMVC.Models.TypeParcelle.EcoTourisme ? "strip-eco" :
                                     p.Type == ClaudeMVC.Models.TypeParcelle.Arboricole ? "strip-arbo" : "strip-vide";
                    <div class="col-md-6">
                        <a asp-controller="Parcelles" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                            <div class="parcelle-card h-100">
                                <div class="card-header-strip @stripClass"></div>
                                <div class="p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <div class="fw-semibold text-dark">@p.Nom</div>
                                            <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@p.Localisation</div>
                                        </div>
                                        <span class="badge bg-@p.CouleurBadge bg-opacity-10 text-@p.CouleurBadge border border-@p.CouleurBadge border-opacity-25 small">
                                            @p.Type
                                        </span>
                                    </div>
                                    <div class="d-flex gap-3 text-muted small">
                                        <span><i class="bi bi-aspect-ratio me-1"></i>@p.SuperficieHa ha</span>
                                        @if (p.RevenusAnnuelsEstimes > 0)
                                        {
                                            <span class="text-success"><i class="bi bi-currency-exchange me-1"></i>@p.RevenusAnnuelsEstimes?.ToString("N0") MAD</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Rendements chart -->
        <div class="bg-white rounded-3 border p-3">
            <h6 class="mb-3 fw-semibold">Rendements historiques – Marge nette (MAD)</h6>
            <canvas id="rendChart" height="120"></canvas>
        </div>
    </div>

    <!-- Prochaines interventions -->
    <div class="col-lg-4">
        <div class="bg-white rounded-3 border p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 fw-semibold">Prochaines interventions</h6>
                <a asp-controller="Interventions" asp-action="Create" class="btn btn-sm btn-success">
                    <i class="bi bi-plus"></i>
                </a>
            </div>
            @if (!Model.ProchainesInterventions.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-calendar-check fs-2 d-block mb-2 opacity-50"></i>
                    Aucune intervention planifiée
                </div>
            }
            else
            {
                @foreach (var i in Model.ProchainesInterventions)
                {
                    var daysUntil = (i.DatePrevue - DateTime.Today).Days;
                    var urgencyColor = daysUntil <= 7 ? "danger" : daysUntil <= 14 ? "warning" : "success";
                    <div class="d-flex align-items-start gap-2 py-2 border-bottom intervention-row">
                        <div class="rounded-2 p-1 flex-shrink-0" style="background:#f3f4f6">
                            <i class="bi @i.IconeType text-@i.CouleurType"></i>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-medium small text-dark text-truncate">@i.Description</div>
                            <div class="text-muted" style="font-size:0.72rem">@i.NomParcelle</div>
                            <div class="mt-1">
                                <span class="calendar-chip bg-@urgencyColor bg-opacity-10 text-@urgencyColor">
                                    @i.DatePrevue.ToString("d MMM")
                                    @(daysUntil == 0 ? " · Aujourd'hui" : daysUntil == 1 ? " · Demain" : $" · J+{daysUntil}")
                                </span>
                            </div>
                        </div>
                    </div>
                }
                <div class="mt-2">
                    <a asp-controller="Interventions" asp-action="Index" class="text-success small text-decoration-none">
                        Toutes les interventions <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.DerniersRendements.Select(r => new {
            annee = r.Annee,
            espece = r.Espece,
            marge = r.MargeNette
        })
    ));
    const labels = [...new Set(data.map(d => d.annee))].sort();
    const especes = [...new Set(data.map(d => d.espece))];
    const colors = ["#52b788","#e9a84c","#94a3b8"];
    const datasets = especes.map((e, idx) => ({
        label: e,
        data: labels.map(a => { const r = data.find(d => d.espece === e && d.annee === a); return r ? r.marge : null; }),
        backgroundColor: colors[idx] + "44",
        borderColor: colors[idx],
        borderWidth: 2, tension: 0.3, fill: true,
    }));
    new Chart(document.getElementById('rendChart'), {
        type: 'line',
        data: { labels, datasets },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } },
            scales: { y: { ticks: { callback: v => v.toLocaleString('fr-MA') + ' MAD' } } }
        }
    });
})();
</script>
}
