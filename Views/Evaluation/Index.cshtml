@model ClaudeMVC.Models.Parcelle?
@{
    ViewData["Title"] = "Évaluation Terrain Vide";
}

@if (Model == null)
{
    <div class="alert alert-warning">Aucun terrain vide trouvé dans la base de données.</div>
    return;
}

<div class="alert alert-warning border-0 mb-4" style="background:#fef3c7">
    <i class="bi bi-clipboard-data me-2"></i>
    <strong>Cadre d'évaluation</strong> — Ce module aide à décider si le terrain vide vaut la peine d'être développé, et selon quel scénario.
</div>

<!-- Fiche terrain -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="parcelle-card h-100">
            <div class="card-header-strip strip-vide"></div>
            <div class="p-3">
                <h6 class="fw-bold">@Model.Nom</h6>
                <div class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@Model.Localisation</div>
                @if (Model.AltitudeMetre != null)
                {
                    <div class="text-muted small mb-2"><i class="bi bi-triangle me-1"></i>@Model.AltitudeMetre</div>
                }
                <p class="text-muted small">@Model.Description</p>
                <div class="text-center rounded-2 p-2 mt-2" style="background:#fef3c7">
                    <div class="fw-bold fs-5">@Model.SuperficieHa ha</div>
                    <div class="text-muted small">Surface disponible</div>
                </div>
                <div class="text-center rounded-2 p-2 mt-2" style="background:#fee2e2">
                    <div class="fw-bold text-danger">-@(Model.CoutsAnnuelsEstimes?.ToString("N0")) MAD/an</div>
                    <div class="text-muted small">Coût d'opportunité actuel</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Critères d'évaluation -->
    <div class="col-md-8">
        <div class="bg-white rounded-3 border p-3 h-100">
            <h6 class="fw-semibold mb-3"><i class="bi bi-check2-square me-2"></i>Critères d'évaluation</h6>
            @{
                var criteres = new[] {
                    ("Qualité du sol", 3, "Analyse en cours – potentiel plantation arboricole modéré"),
                    ("Ressource en eau", 2, "Étude hydrologique prévue – incertitude élevée"),
                    ("Accessibilité", 4, "Bon accès route – atout logistique"),
                    ("Altitude / Climat", 3, "Zone tempérée – pommes, noyers envisageables"),
                    ("Contexte foncier", 5, "Titre foncier clair – aucun litige"),
                    ("Potentiel touristique", 2, "Proximité limitée des circuits randonnée existants"),
                    ("Marché local", 4, "Coopératives actives – débouchés commerciaux disponibles"),
                };
            }
            @foreach (var (nom, note, detail) in criteres)
            {
                var color = note >= 4 ? "success" : note >= 3 ? "warning" : "danger";
                <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                    <div style="min-width:180px" class="small fw-medium">@nom</div>
                    <div class="d-flex gap-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="rounded-1" style="width:18px;height:8px;background:@(i <= note ? (color == "success" ? "#52b788" : color == "warning" ? "#e9a84c" : "#ef4444") : "#e5e7eb")"></span>
                        }
                    </div>
                    <div class="text-muted small flex-grow-1">@detail</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- 3 scénarios -->
<h6 class="fw-semibold mb-3">Scénarios envisagés</h6>
<div class="row g-3 mb-4">
    @{
        var scenarios = new[] {
            ("Plantation arboricole", "success", "bi-tree",
             "Plantation pommiers ou noyers sur 3 ha. Production en 3–5 ans.",
             new[] { ("Investissement initial", "45 000 MAD"), ("Revenu brut (an 5)", "85 000 MAD"), ("Marge nette", "38 000 MAD"), ("ROI", "~4 ans") },
             new[] { "Dépend qualité sol & eau", "Délai de production 3–5 ans", "Risque météo / gel tardif" }),
            ("Location à un agriculteur", "warning", "bi-people",
             "Fermage annuel à un arboriculteur local. Revenu passif immédiat, aucun investissement.",
             new[] { ("Loyer annuel", "8 000–12 000 MAD"), ("Charges propriétaire", "< 1 000 MAD/an"), ("Marge nette", "7 000–11 000 MAD"), ("ROI", "Immédiat") },
             new[] { "Revenus plus faibles", "Dépendance au locataire", "Peu de valorisation du terrain" }),
            ("Attente et valorisation", "info", "bi-hourglass",
             "Conserver le terrain 2–3 ans, compléter les études, puis décider selon les opportunités.",
             new[] { ("Coût annuel", "-3 500 MAD"), ("Option value", "Haute"), ("Flexibilité", "Maximale"), ("Décision optimale", "Après études") },
             new[] { "Coût d'opportunité", "Inflation foncière", "Risque de dégradation" }),
        };
    }
    @foreach (var (titre, color, icone, desc, metriques, risques) in scenarios)
    {
        <div class="col-md-4">
            <div class="bg-white rounded-3 border p-3 h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded-2 p-2" style="background:var(--bs-@(color)-bg-subtle, #f9fafb)">
                        <i class="bi @icone text-@color"></i>
                    </div>
                    <h6 class="fw-semibold mb-0">@titre</h6>
                </div>
                <p class="text-muted small mb-3">@desc</p>
                @foreach (var (k, v) in metriques)
                {
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">@k</span>
                        <span class="fw-medium">@v</span>
                    </div>
                }
                <hr class="my-2">
                <div class="text-muted" style="font-size:0.72rem">
                    <strong>Risques :</strong>
                    @foreach (var r in risques) { <span class="d-block">· @r</span> }
                </div>
            </div>
        </div>
    }
</div>

<!-- Recommandation -->
<div class="bg-white rounded-3 border p-3">
    <h6 class="fw-semibold mb-2"><i class="bi bi-lightbulb me-2 text-warning"></i>Recommandation provisoire</h6>
    <p class="text-muted small mb-3">
        En l'état actuel des informations (analyses de sol et étude hydrologique en cours),
        la <strong>location à court terme</strong> (scénario 2) permet de couvrir les frais de portage
        tout en laissant le temps de finaliser les études avant une décision d'investissement long terme.
        Si l'analyse de sol confirme un potentiel arboricole, le scénario 1 devient le plus rentable à horizon 7 ans.
    </p>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Interventions" asp-action="Index" asp-route-parcelleId="@Model.Id" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-calendar-check me-1"></i>Interventions planifiées
        </a>
        <a asp-controller="Parcelles" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success">
            <i class="bi bi-eye me-1"></i>Fiche parcelle
        </a>
    </div>
</div>
