@model ClaudeMVC.Models.Intervention
@{
    ViewData["Title"] = "Nouvelle intervention";
    var parcelles = ViewBag.Parcelles as List<ClaudeMVC.Models.Parcelle>;
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>Interventions</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="bg-white rounded-3 border p-4">
            <h6 class="fw-bold mb-4">Planifier une intervention</h6>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Parcelle</label>
                    <select asp-for="ParcelleId" class="form-select" required>
                        <option value="">— Choisir une parcelle —</option>
                        @foreach (var p in parcelles!)
                        {
                            <option value="@p.Id">@p.Nom</option>
                        }
                    </select>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Type d'intervention</label>
                        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ClaudeMVC.Models.TypeIntervention>()"></select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Date prévue</label>
                        <input asp-for="DatePrevue" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Description</label>
                    <input asp-for="Description" class="form-control" placeholder="Ex : Taille de fructification pommiers Golden…" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-4">
                        <label class="form-label small fw-semibold">Coût main-d'œuvre (MAD)</label>
                        <input asp-for="CoutMain" type="number" step="100" min="0" class="form-control" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small fw-semibold">Coût matériel (MAD)</label>
                        <input asp-for="CoutMateriel" type="number" step="100" min="0" class="form-control" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small fw-semibold">Journées/homme</label>
                        <input asp-for="NombreJourneesHomme" type="number" min="0" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Observations, produits utilisés…"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-calendar-plus me-1"></i>Planifier
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
