@{
    ViewData["Title"] = "Calendrier annuel";
    var interventions = ViewBag.Interventions as List<ClaudeMVC.Models.Intervention>;
    var mois = new[] { "Jan","Fév","Mar","Avr","Mai","Juin","Juil","Aoû","Sep","Oct","Nov","Déc" };
    var types = Enum.GetValues<ClaudeMVC.Models.TypeIntervention>();
}

<div class="bg-white rounded-3 border p-3 mb-3">
    <p class="text-muted small mb-0">Calendrier des opérations agricoles et d'aménagement pour l'année @DateTime.Now.Year</p>
</div>

<div class="bg-white rounded-3 border overflow-hidden">
    <div class="table-responsive">
        <table class="table table-bordered table-sm mb-0" style="min-width:900px">
            <thead>
                <tr class="table-dark">
                    <th style="width:160px">Parcelle / Type</th>
                    @foreach (var m in mois)
                    {
                        <th class="text-center small" style="width:70px">@m</th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    var groupes = interventions!
                        .Where(i => i.DatePrevue.Year == DateTime.Now.Year)
                        .GroupBy(i => i.NomParcelle);
                }
                @foreach (var groupe in groupes)
                {
                    <tr class="table-light">
                        <td colspan="13" class="fw-semibold small py-1 ps-2">
                            <i class="bi bi-map me-1 text-success"></i>@groupe.Key
                        </td>
                    </tr>
                    var parType = groupe.GroupBy(i => i.Type);
                    foreach (var typeGrp in parType)
                    {
                        <tr>
                            <td class="small ps-3">
                                <i class="bi @typeGrp.First().IconeType me-1 text-@typeGrp.First().CouleurType"></i>
                                @typeGrp.Key
                            </td>
                            @for (int m = 1; m <= 12; m++)
                            {
                                var interv = typeGrp.Where(i => i.DatePrevue.Month == m).ToList();
                                <td class="text-center p-1">
                                    @if (interv.Any())
                                    {
                                        foreach (var i in interv)
                                        {
                                            var dotColor = i.EstRealisee ? "success" : (i.DatePrevue < DateTime.Today ? "danger" : typeGrp.First().CouleurType);
                                            <span title="@i.Description · @i.DatePrevue.ToString("d MMM")"
                                                  class="d-inline-block rounded-circle bg-@dotColor"
                                                  style="width:10px;height:10px;cursor:help;opacity:0.85"></span>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3 d-flex flex-wrap gap-3">
    <span class="small text-muted"><span class="d-inline-block rounded-circle bg-success" style="width:10px;height:10px"></span> Réalisée</span>
    <span class="small text-muted"><span class="d-inline-block rounded-circle bg-danger" style="width:10px;height:10px"></span> En retard</span>
    <span class="small text-muted"><span class="d-inline-block rounded-circle bg-primary" style="width:10px;height:10px"></span> Planifiée</span>
</div>
