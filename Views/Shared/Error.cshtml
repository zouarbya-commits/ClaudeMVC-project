@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
            <h1 class="display-4 fw-bold mt-3">Oops !</h1>
            <p class="lead text-muted">Une erreur inattendue s'est produite.</p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-secondary mt-4">
                    <strong>Request ID :</strong>
                    <code>@Model.RequestId</code>
                </div>
            }

            <a asp-action="Index" asp-controller="Home" class="btn btn-primary mt-3">
                <i class="bi bi-house-door me-2"></i>Retour à l'accueil
            </a>
        </div>
    </div>
</div>
